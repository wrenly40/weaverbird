extends Node2D

## Arena collector — generated by Weaverbird's build stage from the
## approved scope. Collect every target in the round before the
## timer ends; clear the last round to win. Touch a hazard, or let
## the timer reach zero, and the run is lost. Each round adds a
## hazard and a little speed. All tuning (rounds, targets, timer,
## speeds, colours) comes from game_config.json, written by the
## factory — tuning is data, not template surgery.
##
## Art and audio are optional: when Weaverbird's asset stage has run,
## sprites and sounds load from res://assets/; otherwise the game
## draws shapes in code and stays silent, exactly like the skeleton.

const ARENA := Rect2(24, 24, 1104, 600)
const BACKGROUND_COLOR := Color(0.07, 0.08, 0.11)
const FLOOR_COLOR := Color(0.13, 0.15, 0.20)
const HAZARD_COLOR := Color(0.88, 0.30, 0.30)

const TARGET_SPOTS: Array = [
    Vector2(120, 110), Vector2(340, 110), Vector2(576, 115), Vector2(810, 110),
    Vector2(1030, 110), Vector2(200, 300), Vector2(120, 540), Vector2(340, 545),
    Vector2(576, 540), Vector2(810, 545), Vector2(1030, 540), Vector2(950, 300),
]

var cfg: Dictionary = {}
var _world_units: Array = []
var accent := Color(0.42, 0.30, 0.95)
var target_color := Color(0.25, 0.80, 0.45)
var rounds_total: int = 3
var targets_per_round: int = 5
var round_seconds: float = 60.0
var player_speed: float = 330.0
var hazard_speed: float = 1.4

var _player: Player
var _targets: Array = []
var _hazards: Array = []
var _collected: int = 0
var _round_index: int = 0
var _total_collected: int = 0
var _time_left: float = 60.0
var _finished: bool = false
var _is_paused: bool = false
var _between_rounds: float = 0.0
var _hud: Label
var _hint: Label
var _pause_layer: CanvasLayer
var _sfx: Dictionary = {}
var _music: AudioStreamPlayer


func _ready() -> void:
    _maybe_add_model_bridge()
    InputSetup.ensure_actions()
    _load_config()
    SettingsStore.apply_volume(SettingsStore.get_volume())
    _setup_audio()
    _player = Player.new()
    _player.name = "Player"
    _player.arena = ARENA
    _player.colour = accent
    _player.speed = player_speed
    _player.position = Vector2(576, 470)
    add_child(_player)
    _build_hud()
    _build_pause_overlay()
    var pause_input: Node = preload("res://scripts/pause_input.gd").new()
    pause_input.process_mode = Node.PROCESS_MODE_ALWAYS
    pause_input.set("on_pause", Callable(self, "_toggle_pause"))
    add_child(pause_input)
    _start_round(0)


func _load_config() -> void:
    var path := "res://game_config.json"
    if FileAccess.file_exists(path):
        var parsed: Variant = JSON.parse_string(
            FileAccess.get_file_as_string(path))
        if typeof(parsed) == TYPE_DICTIONARY:
            cfg = parsed
    accent = Color.html(str(cfg.get("accent_hex", "#6C4CF1")))
    target_color = Color.html(str(cfg.get("target_hex", "#40CC73")))
    rounds_total = clampi(int(cfg.get("rounds", 3)), 1, 20)
    # The world worker's data wins when present: the rounds live
    # in world/world.json, written as data — never baked into code.
    var world_path := "res://world/world.json"
    if FileAccess.file_exists(world_path):
        var wparsed: Variant = JSON.parse_string(
            FileAccess.get_file_as_string(world_path))
        if typeof(wparsed) == TYPE_DICTIONARY:
            var units: Array = wparsed.get("units", [])
            if not units.is_empty():
                rounds_total = clampi(units.size(), 1, 20)
                _world_units = units
    targets_per_round = clampi(int(cfg.get("targets_per_round", 5)), 1, 12)
    round_seconds = clampf(float(cfg.get("round_seconds", 60.0)), 15.0, 300.0)
    player_speed = clampf(float(cfg.get("player_speed", 330.0)), 150.0, 600.0)
    hazard_speed = clampf(float(cfg.get("hazard_speed", 1.4)), 0.3, 3.5)


func _setup_audio() -> void:
    for sfx_name in ["click", "collect", "hurt", "win", "lose"]:
        var player := WbAssets.make_sfx_player(self, sfx_name + ".wav")
        if player != null:
            _sfx[sfx_name] = player
    _music = WbAssets.start_music(self)


func _play_sfx(sfx_name: String) -> void:
    var player: AudioStreamPlayer = _sfx.get(sfx_name)
    if player != null:
        player.play()


func _round_spots(index: int) -> Array:
    # The world worker's layout for this round when world.json
    # carries one (positions by pattern — ring, arc, scattered,
    # clusters, zigzag); the built-in spot list is the fallback
    # for world files written before layouts existed.
    if index >= 0 and index < _world_units.size():
        var unit: Dictionary = _world_units[index]
        var placed: Array = unit.get("collectibles", [])
        if not placed.is_empty():
            var out: Array = []
            for spot in placed:
                out.append(Vector2(float(spot[0]), float(spot[1])))
            return out
    var count := mini(targets_per_round + index, TARGET_SPOTS.size())
    var offset := index % 3
    var fallback: Array = []
    for i in count:
        fallback.append(TARGET_SPOTS[(i + offset) % TARGET_SPOTS.size()])
    return fallback


func _round_goal(index: int) -> int:
    return _round_spots(index).size()


func _round_hazards(index: int) -> Array:
    # [[centre, patrol_range], ...] — from the world data when it
    # carries hazard definitions, else the built-in table.
    if index >= 0 and index < _world_units.size():
        var unit: Dictionary = _world_units[index]
        var defs: Array = unit.get("hazards", [])
        if not defs.is_empty():
            var out: Array = []
            for d in defs:
                var pos: Array = d.get("pos", [0, 0])
                out.append([Vector2(float(pos[0]), float(pos[1])),
                            float(d.get("range", 0.0))])
            return out
    var spots: Array = [
        [Vector2(400, 330), 170.0], [Vector2(740, 452), 140.0],
        [Vector2(300, 200), 130.0], [Vector2(850, 240), 120.0],
        [Vector2(576, 380), 180.0],
    ]
    return spots.slice(0, mini(2 + index, 5))


func _start_round(index: int) -> void:
    _round_index = index
    for target in _targets:
        target.queue_free()
    for hazard in _hazards:
        hazard.queue_free()
    _targets.clear()
    _hazards.clear()
    _collected = 0
    _time_left = round_seconds
    _player.position = Vector2(576, 470)
    for spot in _round_spots(index):
        var marker := Marker.new()
        marker.kind = "target"
        marker.colour = target_color
        marker.position = spot
        add_child(marker)
        marker.add_to_group("targets")
        _targets.append(marker)
    for definition in _round_hazards(index):
        var hazard := Marker.new()
        hazard.kind = "hazard"
        hazard.colour = HAZARD_COLOR
        hazard.radius = 14.0
        hazard.position = definition[0]
        hazard.patrol_range = float(definition[1])
        hazard.patrol_speed = hazard_speed * (1.0 + 0.12 * index)
        add_child(hazard)
        hazard.add_to_group("hazards")
        _hazards.append(hazard)
    _update_hud()


func _build_hud() -> void:
    var layer := CanvasLayer.new()
    add_child(layer)
    _hud = Label.new()
    _hud.position = Vector2(36, 30)
    _hud.add_theme_font_size_override("font_size", 18)
    _hud.add_theme_color_override("font_color", Color(0.92, 0.93, 0.96))
    layer.add_child(_hud)
    _hint = Label.new()
    _hint.position = Vector2(36, 596)
    _hint.add_theme_font_size_override("font_size", 15)
    _hint.add_theme_color_override("font_color", Color(0.62, 0.66, 0.74))
    _hint.text = str(cfg.get("objective_hint",
        "Collect every glowing target before the time runs out. Avoid the red hazards!"))
    layer.add_child(_hint)


func _build_pause_overlay() -> void:
    _pause_layer = CanvasLayer.new()
    _pause_layer.layer = 5
    _pause_layer.process_mode = Node.PROCESS_MODE_ALWAYS
    _pause_layer.visible = false
    add_child(_pause_layer)
    var dim := ColorRect.new()
    dim.color = Color(0, 0, 0, 0.55)
    dim.set_anchors_preset(Control.PRESET_FULL_RECT)
    _pause_layer.add_child(dim)
    var column := UiTheme.centered_column(_pause_layer)
    column.add_child(UiTheme.make_label("Paused", 32))
    var resume := UiTheme.make_button("Resume")
    resume.pressed.connect(_toggle_pause)
    column.add_child(resume)
    var restart := UiTheme.make_button("Restart")
    restart.pressed.connect(_on_restart_pressed)
    column.add_child(restart)
    var menu := UiTheme.make_button("Main menu")
    menu.pressed.connect(_on_menu_pressed)
    column.add_child(menu)


func _process(delta: float) -> void:
    if _finished or _is_paused:
        return
    if _between_rounds > 0.0:
        _between_rounds -= delta
        if _between_rounds <= 0.0:
            _start_round(_round_index + 1)
        return
    _time_left -= delta
    if _time_left <= 0.0:
        _time_left = 0.0
        _lose("Time ran out.")
        return
    _check_markers()
    _update_hud()


func _check_markers() -> void:
    for target in _targets.duplicate():
        var reach: float = _player.radius + target.radius
        if _player.global_position.distance_to(target.global_position) <= reach:
            _targets.erase(target)
            target.queue_free()
            _collected += 1
            _total_collected += 1
            _play_sfx("collect")
            if _collected >= _round_goal(_round_index):
                if _round_index + 1 >= rounds_total:
                    _win()
                else:
                    _between_rounds = 1.0
                    _update_hud()
                return
    for hazard in _hazards:
        var reach: float = _player.radius + hazard.radius - 2.0
        if _player.global_position.distance_to(hazard.global_position) <= reach:
            _lose("You touched a hazard.")
            return


func _update_hud() -> void:
    var goal := _round_goal(_round_index)
    _hud.text = "Round: %d / %d    Targets: %d / %d    Time: %d" % [
        _round_index + 1, rounds_total, _collected, goal, int(ceil(_time_left))]


func _toggle_pause() -> void:
    if _finished:
        return
    _is_paused = not _is_paused
    get_tree().paused = _is_paused
    _pause_layer.visible = _is_paused


func _on_restart_pressed() -> void:
    get_tree().paused = false
    get_tree().reload_current_scene()


func _on_menu_pressed() -> void:
    get_tree().paused = false
    get_tree().change_scene_to_file("res://scenes/main_menu.tscn")


func _targets_total() -> int:
    var total := 0
    for i in rounds_total:
        total += _round_goal(i)
    return total


func _win() -> void:
    _finished = true
    _play_sfx("win")
    SettingsStore.record_run(true, _total_collected)
    RunInfo.result = "win"
    RunInfo.targets_collected = _total_collected
    RunInfo.targets_total = _targets_total()
    RunInfo.message = "Every round cleared with %d seconds to spare." % int(ceil(_time_left))
    get_tree().change_scene_to_file("res://scenes/win.tscn")


func _lose(reason: String) -> void:
    if _finished:
        return
    _finished = true
    _play_sfx("lose")
    SettingsStore.record_run(false, _total_collected)
    RunInfo.result = "lose"
    RunInfo.targets_collected = _total_collected
    RunInfo.targets_total = _targets_total()
    RunInfo.message = reason
    get_tree().change_scene_to_file("res://scenes/game_over.tscn")


func _draw() -> void:
    draw_rect(Rect2(0, 0, 1152, 648), BACKGROUND_COLOR)
    draw_rect(ARENA, FLOOR_COLOR)
    draw_rect(ARENA, Color(1, 1, 1, 0.25), false, 2.0)

func _maybe_add_model_bridge() -> void:
    var args: Array = Array(OS.get_cmdline_args()) + Array(OS.get_cmdline_user_args())
    if not args.has("--model-bridge"):
        return
    if get_tree().root.get_node_or_null("WbModelBridge") != null:
        return
    if not ResourceLoader.exists("res://tests/model_bridge.gd"):
        return
    var bridge: Node = load("res://tests/model_bridge.gd").new()
    bridge.name = "WbModelBridge"
    get_tree().root.add_child.call_deferred(bridge)

func bridge_actions() -> Array:
    return ["move_left", "move_right", "move_up", "move_down", "pause", "wait", "start"]


func bridge_state() -> Dictionary:
    var goal := _round_goal(_round_index)
    var spots: Array = []
    for target in get_tree().get_nodes_in_group("targets"):
        var node := target as Node2D
        if node != null:
            spots.append([round(node.global_position.x), round(node.global_position.y)])
    var dangers: Array = []
    var patrols: Array = []
    for hazard in get_tree().get_nodes_in_group("hazards"):
        var node := hazard as Node2D
        if node != null:
            dangers.append([round(node.global_position.x), round(node.global_position.y)])
            var base: Vector2 = hazard.get("_base")
            var span: float = float(hazard.get("patrol_range"))
            patrols.append([round(base.x - span), round(base.y),
                            round(base.x + span), round(base.y)])
    return {
        "player_pos": [round(_player.global_position.x), round(_player.global_position.y)],
        "targets_pos": spots,
        "hazards_pos": dangers,
        "hazards_patrol": patrols,
        "collected_this_round": _collected,
        "round_goal": goal,
        "total_collected": _total_collected,
        "round": _round_index + 1,
        "rounds": rounds_total,
        "time_left": int(ceil(_time_left)),
        "targets_left": spots.size(),
        "hint": str(cfg.get("objective_hint", "")),
        "finished": _finished,
    }
