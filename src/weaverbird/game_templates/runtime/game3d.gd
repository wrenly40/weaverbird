extends Node3D
## The generic runtime, in 3D — generated by Weaverbird's build
## stage from the approved scope's PLAN. The top-down movement
## lifted onto a ground plane: the world data lays each round
## out (collectible positions, hazard waypoints and behaviours,
## obstacle blocks, a goal), the plan in game_config.json says
## the objective (collect, reach or survive) and how the run
## can fail, and the HUD speaks the maker's own nouns. Materials
## and the sky come from the style-lock palette: the background
## is the accent darkened by 55%, the ambient that same tone
## lifted back up. The shell (menus, pause, save, settings) is
## the same 2D Control UI every Weaverbird game ships.

const PlayerScript := preload("res://scripts/player.gd")

var config: Dictionary = {}
var world: Dictionary = {}
var palette: Dictionary = {}
var plan: Dictionary = {}
var objective: String = "collect"
var fail_rules: Array = []
var collectible_label: String = "Targets"
var hazard_label: String = "Hazards"
var round_index := 0
var _unit_index := 0
var _deaths := 0
var lives := 1
var collected := 0
var round_total := 0
var _total_collected := 0
var targets_total := 0
var units_done := 0
var time_left := 0.0
var playing := false
var finished := false
var _grace := 0.0
var player: CharacterBody3D = null
var camera: Camera3D = null
var orbs: Array = []
var hazards: Array = []
var obstacle_positions: Array = []
var goal_node: Area3D = null
var goal_mesh: MeshInstance3D = null
var spawn_point := Vector3(0, 0.6, -9)
var round_root: Node3D = null
var hud_label: Label
var pause_layer: CanvasLayer
var _is_paused: bool = false
var _sfx: Dictionary = {}
var _music: AudioStreamPlayer = null


func _ready() -> void:
	InputSetup.ensure_actions()
	randomize()
	config = _load_json("res://game_config.json")
	world = _load_json("res://world/world.json")
	if config.is_empty():
		config = {"rounds": 1, "targets_per_round": 5,
			"round_seconds": 60, "player_speed": 11.0,
			"hazard_speed": 1.4}
	# The palette's hexes live at the TOP of game_config.json
	# (accent_hex, target_hex, … — the shape every Weaverbird
	# config is written in), not in a nested "palette" object;
	# a nested object, if one is ever present, wins per key.
	palette = {}
	for key in ["accent_hex", "target_hex", "hazard_hex",
			"platform_hex", "crate_hex"]:
		if config.has(key):
			palette[key] = config[key]
	var nested_palette = config.get("palette", {})
	if typeof(nested_palette) == TYPE_DICTIONARY:
		for key in nested_palette:
			palette[key] = nested_palette[key]
	var raw_plan = config.get("plan", {})
	if typeof(raw_plan) == TYPE_DICTIONARY:
		plan = raw_plan
	objective = String(plan.get("objective", objective))
	fail_rules = plan.get("fail", [])
	collectible_label = String(config.get(
		"collectible_label", collectible_label))
	for entity in plan.get("entities", []):
		if typeof(entity) == TYPE_DICTIONARY \
				and String(entity.get("kind", "")) == "hazard":
			hazard_label = String(entity.get("label", hazard_label))
	lives = clampi(int(config.get("lives", 1)), 1, 9)
	_build_environment()
	for unit in world.get("units", []):
		targets_total += (unit.get("collectibles", []) as Array).size()
	_setup_audio()
	_build_hud()
	_build_pause_overlay()
	var pause_input: Node = preload("res://scripts/pause_input.gd").new()
	pause_input.process_mode = Node.PROCESS_MODE_ALWAYS
	pause_input.set("on_pause", Callable(self, "_toggle_pause"))
	add_child(pause_input)
	_start_round(0)


func _load_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		return {}
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		return {}
	var parsed = JSON.parse_string(text)
	return parsed if typeof(parsed) == TYPE_DICTIONARY else {}


func _mat(hex_value, roughness := 0.85) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = Color(String(hex_value))
	material.roughness = roughness
	return material


func _tinted(base: Color, tint: float) -> Color:
	# A per-instance tint from the world data: >1 lightens
	# toward white, <1 deepens toward black.
	if tint >= 1.0:
		return base.lerp(Color(1, 1, 1), tint - 1.0)
	return base.lerp(Color(0, 0, 0), 1.0 - tint)


func _mat_emissive(hex_value, tint := 1.0, roughness := 0.35,
		energy := 0.55) -> StandardMaterial3D:
	# A self-lit material: collectibles glow in their own
	# colour, so they read as the goal from across the arena.
	var material := StandardMaterial3D.new()
	var colour := _tinted(Color(String(hex_value)), tint)
	material.albedo_color = colour
	material.roughness = roughness
	material.emission_enabled = true
	material.emission = colour
	material.emission_energy_multiplier = energy
	return material


func _setup_audio() -> void:
	for sfx_name in ["click", "collect", "hurt", "win", "lose"]:
		var sfx_player := WbAssets.make_sfx_player(self, sfx_name + ".wav")
		if sfx_player != null:
			_sfx[sfx_name] = sfx_player
	_music = WbAssets.start_music(self)


func _play_sfx(sfx_name: String) -> void:
	var sfx_player: AudioStreamPlayer = _sfx.get(sfx_name)
	if sfx_player != null:
		sfx_player.play()


func _units_total() -> int:
	var units: Array = world.get("units", [])
	return units.size() if not units.is_empty() \
		else int(config.get("rounds", 1))


# ------------------------------------------------------------------
# Scene construction


func _build_environment() -> void:
	# The sky follows the style lock: the background is the
	# palette's accent darkened by 55%, and the ambient light is
	# that same tone lifted back up, so the scene's whole light
	# belongs to the palette.
	var accent := Color(String(palette.get("accent_hex", "#5A5480")))
	var background := accent.darkened(0.55)
	var env := Environment.new()
	env.background_mode = Environment.BG_COLOR
	env.background_color = background
	env.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	env.ambient_light_color = background.lightened(0.55)
	env.ambient_light_energy = 0.9
	var world_env := WorldEnvironment.new()
	world_env.environment = env
	add_child(world_env)
	var sun := DirectionalLight3D.new()
	sun.rotation_degrees = Vector3(-52, -28, 0)
	sun.light_energy = 0.9
	sun.shadow_enabled = true
	add_child(sun)
	camera = Camera3D.new()
	camera.current = true
	add_child(camera)


func _start_round(index: int) -> void:
	if round_root:
		round_root.queue_free()
	round_root = Node3D.new()
	add_child(round_root)
	orbs.clear()
	hazards.clear()
	obstacle_positions.clear()
	goal_node = null
	goal_mesh = null
	collected = 0
	var units: Array = world.get("units", [])
	if index >= units.size():
		_win()
		return
	round_index = index
	_unit_index = index
	var unit: Dictionary = units[index]
	var ground: Array = unit.get("ground", [40, 24])
	var spawn: Array = unit.get("spawn", [0, -9])
	spawn_point = Vector3(spawn[0], 0.6, spawn[1])
	# The ground plane itself.
	var ground_body := StaticBody3D.new()
	var ground_mesh := MeshInstance3D.new()
	var ground_box := BoxMesh.new()
	ground_box.size = Vector3(ground[0], 0.5, ground[1])
	ground_box.material = _mat(palette.get("platform_hex", "#7A4E21"))
	ground_mesh.mesh = ground_box
	ground_mesh.position = Vector3(0, -0.25, 0)
	var ground_shape := CollisionShape3D.new()
	var ground_collision := BoxShape3D.new()
	ground_collision.size = Vector3(ground[0], 0.5, ground[1])
	ground_shape.shape = ground_collision
	ground_shape.position = Vector3(0, -0.25, 0)
	ground_body.add_child(ground_mesh)
	ground_body.add_child(ground_shape)
	round_root.add_child(ground_body)
	# Obstacle blocks (the world's dict shape, or the plan
	# world's [x, z, w, d] rows).
	for obstacle in unit.get("obstacles", []):
		var pos: Array
		var size: Array
		var height := 1.5
		if typeof(obstacle) == TYPE_DICTIONARY:
			pos = obstacle.get("pos", [0, 0])
			size = obstacle.get("size", [2, 2])
			height = float(obstacle.get("height", 1.5))
		else:
			var row: Array = obstacle
			pos = [row[0], row[1]]
			size = [row[2], row[3]] if row.size() >= 4 else [2, 2]
		var mesh := BoxMesh.new()
		mesh.size = Vector3(size[0], height, size[1])
		mesh.material = _mat(palette.get("crate_hex", "#C98A3D"))
		var instance := MeshInstance3D.new()
		instance.mesh = mesh
		var body := StaticBody3D.new()
		var shape := CollisionShape3D.new()
		var box := BoxShape3D.new()
		box.size = Vector3(size[0], height, size[1])
		shape.shape = box
		body.add_child(instance)
		body.add_child(shape)
		body.position = Vector3(pos[0], height / 2.0, pos[1])
		round_root.add_child(body)
		obstacle_positions.append([pos[0], pos[1],
			maxf(size[0], size[1]) / 2.0])
	# Collectible orbs: a glowing sphere with a brighter inner
	# core. Each instance applies the variation the world data
	# recorded for it (tint + scale, deterministic), and its
	# roughness steps through a fixed spread, so no two orbs
	# are quite the same object.
	var variants: Array = unit.get("collectible_variants", [])
	var target_hex := String(palette.get("target_hex", "#2FBF71"))
	for orb_index in range((unit.get("collectibles", []) as Array).size()):
		var point: Array = unit["collectibles"][orb_index]
		var variant: Dictionary = variants[orb_index] \
			if orb_index < variants.size() else {}
		var tint := float(variant.get("tint", 1.0))
		var orb := Area3D.new()
		orb.add_to_group("collectibles")
		orb.add_to_group("targets")
		var mesh := MeshInstance3D.new()
		var sphere := SphereMesh.new()
		sphere.radius = 0.45
		sphere.height = 0.9
		sphere.material = _mat_emissive(
			target_hex, tint,
			0.25 + 0.02 * float((orb_index * 7) % 11), 0.55)
		mesh.mesh = sphere
		var core := MeshInstance3D.new()
		var core_sphere := SphereMesh.new()
		core_sphere.radius = 0.20
		core_sphere.height = 0.4
		core_sphere.material = _mat_emissive(
			target_hex, tint * 1.3, 0.2, 1.5)
		core.mesh = core_sphere
		var shape := CollisionShape3D.new()
		var ball := SphereShape3D.new()
		ball.radius = 0.7
		shape.shape = ball
		orb.add_child(mesh)
		orb.add_child(core)
		orb.add_child(shape)
		orb.scale = Vector3.ONE * float(variant.get("scale", 1.0))
		orb.position = Vector3(point[0], 0.8, point[1])
		orb.body_entered.connect(_on_orb_body.bind(orb))
		round_root.add_child(orb)
		orbs.append(orb)
	round_total = orbs.size()
	# The goal, for reach plans (and collect plans that end at
	# one): a standing ring in the accent.
	if unit.has("goal"):
		var g: Array = unit["goal"]
		var goal := Area3D.new()
		goal.add_to_group("goal")
		var mesh := MeshInstance3D.new()
		var torus := TorusMesh.new()
		torus.inner_radius = 0.75
		torus.outer_radius = 1.0
		torus.material = _mat(palette.get("accent_hex", "#6C4CF1"), 0.4)
		mesh.mesh = torus
		mesh.position = Vector3(0, 1.1, 0)
		var shape := CollisionShape3D.new()
		var ball := SphereShape3D.new()
		ball.radius = 1.1
		shape.shape = ball
		shape.position = Vector3(0, 1.1, 0)
		goal.add_child(mesh)
		goal.add_child(shape)
		goal.position = Vector3(g[0], 0.0, g[1])
		goal.body_entered.connect(_on_goal_body)
		round_root.add_child(goal)
		goal_node = goal
		goal_mesh = mesh
		_refresh_goal_lock()
	# Hazards, moving per the behaviour the plan assigned.
	for hazard_data in unit.get("hazards", []):
		var waypoints: Array = hazard_data.get("waypoints", [])
		var start: Array = hazard_data.get("pos", [])
		if start.is_empty() and not waypoints.is_empty():
			start = waypoints[0]
		if start.is_empty():
			continue
		var hazard := Area3D.new()
		hazard.add_to_group("hazards")
		# A spiked form — cones radiating from a core — so the
		# hazard's menace reads in silhouette, the way the 2D
		# sprite's spikes do.
		var hazard_mat := _mat(palette.get("hazard_hex", "#E63B3B"), 0.5)
		var core := MeshInstance3D.new()
		var core_sphere := SphereMesh.new()
		core_sphere.radius = 0.5
		core_sphere.height = 1.0
		core_sphere.material = hazard_mat
		core.mesh = core_sphere
		hazard.add_child(core)
		for k in range(7):
			var spike := MeshInstance3D.new()
			var cone := CylinderMesh.new()
			cone.top_radius = 0.0
			cone.bottom_radius = 0.20
			cone.height = 0.62
			cone.material = hazard_mat
			spike.mesh = cone
			if k < 6:
				var ang := TAU * float(k) / 6.0
				var dir := Vector3(cos(ang), 0, sin(ang))
				spike.position = dir * 0.58
				spike.quaternion = Quaternion(Vector3.UP, dir)
			else:
				spike.position = Vector3(0, 0.62, 0)
			hazard.add_child(spike)
		var shape := CollisionShape3D.new()
		var box := BoxShape3D.new()
		box.size = Vector3(1.1, 1.1, 1.1)
		shape.shape = box
		hazard.add_child(shape)
		hazard.position = Vector3(start[0], 0.7, start[1])
		hazard.set_meta("behaviour",
			String(hazard_data.get("behaviour", "patrol")))
		if waypoints.size() >= 2:
			var a: Array = waypoints[0]
			var b: Array = waypoints[1]
			hazard.set_meta("from", Vector3(a[0], 0.7, a[1]))
			hazard.set_meta("to", Vector3(b[0], 0.7, b[1]))
		else:
			hazard.set_meta("from", hazard.position)
			hazard.set_meta("to", hazard.position)
		hazard.set_meta("t", 0.0)
		hazard.set_meta("wander_goal", hazard.position)
		hazard.set_meta("wander_wait", 0.0)
		hazard.body_entered.connect(_on_hazard_body)
		round_root.add_child(hazard)
		hazards.append(hazard)
	# The player.
	player = CharacterBody3D.new()
	player.name = "Player"
	player.set_script(PlayerScript)
	player.set("speed", float(config.get("player_speed", 11.0)))
	player.position = spawn_point
	round_root.add_child(player)
	# Config wins over the unit's build-time copy: balance
	# patches tune round_seconds in the config alone.
	time_left = float(config.get("round_seconds",
		unit.get("round_seconds", 60)))
	_grace = 0.0
	playing = true
	_update_hud()


func _refresh_goal_lock() -> void:
	if goal_node == null:
		return
	var locked := objective == "collect" and collected < round_total
	# Node3D has no modulate (that is a 2D/CanvasItem property);
	# the 3D analogue is the mesh's transparency.
	if goal_mesh != null:
		goal_mesh.transparency = 0.65 if locked else 0.0


func _build_hud() -> void:
	var layer := CanvasLayer.new()
	add_child(layer)
	hud_label = UiTheme.make_label("", 22)
	hud_label.set_anchors_preset(Control.PRESET_CENTER_TOP)
	hud_label.position = Vector2(-260, 14)
	hud_label.size = Vector2(520, 30)
	hud_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	layer.add_child(hud_label)
	var hint := UiTheme.make_label(String(config.get("objective_hint",
		"Follow the on-screen objective.")), 18)
	hint.set_anchors_preset(Control.PRESET_CENTER_BOTTOM)
	hint.position = Vector2(-360, -64)
	hint.size = Vector2(720, 30)
	hint.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	layer.add_child(hint)


func _build_pause_overlay() -> void:
	pause_layer = CanvasLayer.new()
	pause_layer.layer = 5
	pause_layer.process_mode = Node.PROCESS_MODE_ALWAYS
	pause_layer.visible = false
	add_child(pause_layer)
	var dim := ColorRect.new()
	dim.color = Color(0, 0, 0, 0.55)
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	pause_layer.add_child(dim)
	var column := UiTheme.centered_column(pause_layer)
	column.add_child(UiTheme.make_label("Paused", 32))
	var resume := UiTheme.make_button("Resume")
	resume.pressed.connect(_toggle_pause)
	column.add_child(resume)
	var restart := UiTheme.make_button("Restart")
	restart.pressed.connect(_on_restart_pressed)
	column.add_child(restart)
	var menu := UiTheme.make_button("Main menu")
	menu.pressed.connect(_on_menu_pressed)
	column.add_child(menu)


func _toggle_pause() -> void:
	if finished:
		return
	get_tree().paused = not get_tree().paused
	_is_paused = get_tree().paused
	pause_layer.visible = get_tree().paused


func _on_restart_pressed() -> void:
	get_tree().paused = false
	_is_paused = false
	pause_layer.visible = false
	_total_collected -= collected
	_start_round(round_index)


func _on_menu_pressed() -> void:
	get_tree().paused = false
	_is_paused = false
	get_tree().change_scene_to_file("res://scenes/main_menu.tscn")


func _update_hud() -> void:
	if hud_label:
		var parts: Array = ["Round %d/%d" % [round_index + 1,
			_units_total()]]
		if objective == "collect":
			parts.append("%s %d/%d" % [collectible_label, collected,
				round_total])
		elif objective == "reach":
			parts.append("%s %d" % [collectible_label, _total_collected])
		if objective == "survive" or fail_rules.has("timer"):
			parts.append("Time %d" % int(ceil(maxf(time_left, 0.0))))
		if fail_rules.has("hazard_contacts") and \
				int(config.get("lives", 1)) > 1:
			parts.append("Lives %d" % maxi(lives, 0))
		hud_label.text = " · ".join(parts)


# ------------------------------------------------------------------
# Play


func _physics_process(delta: float) -> void:
	if not playing or finished:
		return
	if _grace > 0.0:
		_grace -= delta
	var speed := float(config.get("hazard_speed", 1.4))
	for hazard in hazards:
		if not is_instance_valid(hazard):
			continue
		_move_hazard(hazard, speed, delta)
	for orb in orbs:
		if is_instance_valid(orb):
			orb.rotate_y(delta * 2.2)
	if player:
		# The ground slab is the world: keep the player on it
		# (a step past the edge reads as falling out of the world).
		var units_now: Array = world.get("units", [])
		var ground_now: Array = [40, 24]
		if round_index >= 0 and round_index < units_now.size():
			ground_now = units_now[round_index].get("ground", [40, 24])
		var pos := player.global_position
		pos.x = clampf(pos.x, -float(ground_now[0]) / 2.0 + 0.6,
			float(ground_now[0]) / 2.0 - 0.6)
		pos.z = clampf(pos.z, -float(ground_now[1]) / 2.0 + 0.6,
			float(ground_now[1]) / 2.0 - 0.6)
		player.global_position = pos
	if player and camera:
		var target := player.global_position + Vector3(0, 17, 11)
		camera.global_position = camera.global_position.lerp(
			target, minf(delta * 6.0, 1.0))
		camera.look_at(player.global_position, Vector3.UP)
	if objective == "survive":
		time_left -= delta
		_update_hud()
		if time_left <= 0.0:
			playing = false
			call_deferred("_finish_round")
		return
	if fail_rules.has("timer"):
		time_left -= delta
		_update_hud()
		if time_left <= 0.0:
			_lose("Time ran out.")


func _move_hazard(hazard: Area3D, speed: float, delta: float) -> void:
	match String(hazard.get_meta("behaviour", "patrol")):
		"chase":
			if player == null:
				return
			var to := player.global_position - hazard.global_position
			to.y = 0.0
			if to.length() > 0.3:
				hazard.global_position += \
					to.normalized() * speed * 2.0 * delta
		"wander":
			var wait := float(hazard.get_meta("wander_wait")) - delta
			if wait > 0.0:
				hazard.set_meta("wander_wait", wait)
				return
			var goal: Vector3 = hazard.get_meta("wander_goal")
			var to := goal - hazard.global_position
			to.y = 0.0
			if to.length() < 0.4:
				hazard.set_meta("wander_wait", randf_range(0.4, 1.4))
				hazard.set_meta("wander_goal", Vector3(
					clampf(hazard.global_position.x
						+ randf_range(-6.0, 6.0), -18.0, 18.0), 0.7,
					clampf(hazard.global_position.z
						+ randf_range(-4.0, 4.0), -10.0, 10.0)))
				return
			hazard.global_position += \
				to.normalized() * speed * 1.2 * delta
		"static":
			pass
		_:  # patrol between the waypoints
			var from: Vector3 = hazard.get_meta("from")
			var to: Vector3 = hazard.get_meta("to")
			var t := float(hazard.get_meta("t")) \
				+ delta * speed / maxf(from.distance_to(to), 0.01)
			if t >= 1.0:
				t = 0.0
				hazard.set_meta("from", to)
				hazard.set_meta("to", from)
				var swap: Vector3 = from
				from = to
				to = swap
			hazard.set_meta("t", t)
			hazard.position = from.lerp(to, t)


func _on_orb_body(body: Node3D, orb: Area3D) -> void:
	if body != player or not playing or finished:
		return
	# Bookkeeping only inside the physics callback — removing a
	# collision object here is an engine error, so the orb's
	# removal and any round transition are deferred.
	orbs.erase(orb)
	orb.set_deferred("monitoring", false)
	orb.hide()
	orb.call_deferred("remove_from_group", "collectibles")
	orb.call_deferred("remove_from_group", "targets")
	collected += 1
	_total_collected += 1
	_play_sfx("collect")
	_refresh_goal_lock()
	_update_hud()
	if objective == "collect" and collected >= round_total \
			and goal_node == null:
		playing = false
		call_deferred("_finish_round")


func _on_goal_body(body: Node3D) -> void:
	if body != player or not playing or finished:
		return
	if objective == "reach" or (objective == "collect"
			and collected >= round_total):
		playing = false
		call_deferred("_finish_round")


func _finish_round() -> void:
	if finished:
		return
	units_done += 1
	if round_index + 1 >= _units_total():
		_win()
	else:
		_start_round(round_index + 1)


func _on_hazard_body(body: Node3D) -> void:
	if body != player or not playing or finished:
		return
	if not fail_rules.has("hazard_contacts") or _grace > 0.0:
		return
	# Deferred for the same reason as the orb handler: leaving
	# the scene from inside the physics callback makes the
	# engine remove collision objects mid-flush, which errors.
	playing = false
	_play_sfx("hurt")
	call_deferred("_hurt")


func _hurt() -> void:
	if finished:
		return
	_deaths += 1
	lives -= 1
	if lives <= 0:
		_lose("The %s got you." % hazard_label.to_lower())
		return
	player.position = spawn_point
	_grace = 1.2
	playing = true


func _win() -> void:
	if finished:
		return
	finished = true
	playing = false
	_play_sfx("win")
	var totals := _score_totals()
	SettingsStore.record_run(true, int(totals[0]))
	RunInfo.result = "win"
	RunInfo.deaths = _deaths
	RunInfo.targets_collected = int(totals[0])
	RunInfo.targets_total = int(totals[1])
	RunInfo.targets_label = collectible_label \
		if objective == "collect" else ""
	RunInfo.message = "Every round cleared."
	get_tree().change_scene_to_file("res://scenes/win.tscn")


func _lose(reason: String) -> void:
	if finished:
		return
	finished = true
	playing = false
	_play_sfx("lose")
	var totals := _score_totals()
	SettingsStore.record_run(false, int(totals[0]))
	RunInfo.result = "lose"
	RunInfo.deaths = _deaths
	RunInfo.targets_collected = int(totals[0])
	RunInfo.targets_total = int(totals[1])
	RunInfo.targets_label = collectible_label \
		if objective == "collect" else ""
	RunInfo.message = reason
	get_tree().change_scene_to_file("res://scenes/game_over.tscn")


func _score_totals() -> Array:
	if objective == "collect":
		return [_total_collected, maxi(targets_total, 1)]
	return [units_done, maxi(_units_total(), 1)]


# ------------------------------------------------------------------
# The model bridge facts: the same bridge_state() shape every
# Weaverbird game exposes, with 3D positions ([x, y, z]).


func bridge_state() -> Dictionary:
	var collectibles_pos: Array = []
	for orb in orbs:
		if is_instance_valid(orb):
			var p: Vector3 = orb.global_position
			collectibles_pos.append([p.x, p.y, p.z])
	var hazards_pos: Array = []
	for hazard in hazards:
		if is_instance_valid(hazard):
			var p: Vector3 = hazard.global_position
			hazards_pos.append([p.x, p.y, p.z])
	var player_pos: Array = []
	if player:
		var p: Vector3 = player.global_position
		player_pos = [p.x, p.y, p.z]
	var goal_pos: Array = []
	if goal_node != null and is_instance_valid(goal_node):
		var p: Vector3 = goal_node.global_position
		goal_pos = [p.x, p.y, p.z]
	return {
		"screen": "game",
		"objective": String(config.get("objective_hint", "")),
		"player_pos": player_pos,
		"targets_pos": collectibles_pos,
		"collectibles_pos": collectibles_pos,
		"hazards_pos": hazards_pos,
		"hazard_count": hazards_pos.size(),
		"obstacles_pos": obstacle_positions,
		"goal_pos": goal_pos,
		"round": round_index + 1,
		"rounds_total": _units_total(),
		"collected": collected,
		"targets_left": round_total - collected,
		"time_left": time_left,
		"lives": lives,
		"deaths": _deaths,
		"movement": "top_down_3d",
		"objective_kind": objective,
	}


func bridge_actions() -> Array:
	return ["move_left", "move_right", "move_up", "move_down",
		"pause", "wait"]
