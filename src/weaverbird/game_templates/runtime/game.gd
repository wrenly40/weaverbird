# The model bridge

func _maybe_add_model_bridge() -> void:
    var args: Array = Array(OS.get_cmdline_args()) + Array(OS.get_cmdline_user_args())
    if not args.has("--model-bridge"):
        return
    if get_tree().root.get_node_or_null("WbModelBridge") != null:
        return
    if not ResourceLoader.exists("res://tests/model_bridge.gd"):
        return
    var bridge: Node = load("res://tests/model_bridge.gd").new()
    bridge.name = "WbModelBridge"
    get_tree().root.add_child.call_deferred(bridge)


func bridge_actions() -> Array:
    return ["move_left", "move_right", "move_up", "move_down",
            "interact", "pause", "wait", "start"]


func bridge_state() -> Dictionary:
    match movement:
        "side_view":
            var targets_pos: Array = []
            for node in get_tree().get_nodes_in_group("targets"):
                var n := node as Node2D
                if n != null:
                    targets_pos.append([round(n.global_position.x),
                                        round(n.global_position.y)])
            var hazards_pos: Array = []
            for node in get_tree().get_nodes_in_group("hazards"):
                var n := node as Node2D
                if n != null:
                    hazards_pos.append([round(n.global_position.x),
                                        round(n.global_position.y)])
            return {
                "player_pos": [round(_player.global_position.x),
                               round(_player.global_position.y)],
                "targets_pos": targets_pos,
                "hazards_pos": hazards_pos,
                "goal_pos": [round(_exit_pos.x), round(_exit_pos.y)],
                "exit_pos": [round(_exit_pos.x), round(_exit_pos.y)],
                "lives": _lives,
                "deaths": _deaths,
                "stars": stars_collected,
                "level": _unit_index + 1,
                "levels": maxi(_world_units.size(), 1),
                "movement": movement,
                "objective": objective,
                "hint": str(cfg.get("objective_hint", "")),
                "finished": _finished,
            }
        "grid_step":
            var on_pads := 0
            for crate in _crates:
                if crate in _pads:
                    on_pads += 1
            var crates_pos: Array = []
            for crate in _crates:
                var c := _cell_center(crate)
                crates_pos.append([round(c.x), round(c.y)])
            var zones_pos: Array = []
            for pad in _pads:
                var c := _cell_center(pad)
                zones_pos.append([round(c.x), round(c.y)])
            var pc := _cell_center(_player_cell)
            return {
                "player_pos": [round(pc.x), round(pc.y)],
                "player_cell": [_player_cell.x, _player_cell.y],
                "crates": _crates.size(),
                "crates_pos": crates_pos,
                "zones_pos": zones_pos,
                "crates_on_pads": on_pads,
                "moves_used": moves_used,
                "move_budget": move_budget,
                "puzzle": _unit_index + 1,
                "puzzles": puzzles.size(),
                "deadlock": deadlock_detected,
                "movement": movement,
                "objective": objective,
                "hint": str(cfg.get("objective_hint", "")),
                "finished": _finished,
            }
        _:
            var spots: Array = []
            for target in get_tree().get_nodes_in_group("targets"):
                var node := target as Node2D
                if node != null:
                    spots.append([round(node.global_position.x),
                                  round(node.global_position.y)])
            var dangers: Array = []
            var patrols: Array = []
            for hazard in get_tree().get_nodes_in_group("hazards"):
                var node := hazard as Node2D
                if node != null:
                    dangers.append([round(node.global_position.x),
                                    round(node.global_position.y)])
                    var base: Vector2 = hazard.get("_base")
                    var span: float = float(hazard.get("patrol_range"))
                    patrols.append([round(base.x - span), round(base.y),
                                    round(base.x + span), round(base.y)])
            var goal_pos: Array = []
            if _goal_node != null:
                goal_pos = [round(_goal_node.global_position.x),
                            round(_goal_node.global_position.y)]
            return {
                "player_pos": [round(_player.global_position.x),
                               round(_player.global_position.y)],
                "targets_pos": spots,
                "hazards_pos": dangers,
                "hazards_patrol": patrols,
                "goal_pos": goal_pos,
                "collected": _total_collected,
                "collected_this_round": _collected,
                "round_goal": _round_goal_count(),
                "total_collected": _total_collected,
                "round": _unit_index + 1,
                "rounds": maxi(_world_units.size(), 1),
                "time_left": int(ceil(_time_left)),
                "targets_left": spots.size(),
                "lives": _lives,
                "deaths": _deaths,
                "movement": movement,
                "objective": objective,
                "hint": str(cfg.get("objective_hint", "")),
                "finished": _finished,
            }
