extends Node2D

## The generic runtime — generated by Weaverbird's build stage
## from the approved scope's PLAN. One interpreter serves every
## 2D game the factory makes: the plan in game_config.json (and
## the world data in world/world.json) says how the player moves
## (top_down_2d, side_view or grid_step), what the objective is
## (collect, reach, survive or deliver), how the run can fail
## (timer, hazard_contacts, fall), and what the entities are —
## the maker's own nouns for them ride along as labels, so the
## HUD speaks the scope's language. Tuning (speeds, seconds,
## lives, budgets) comes from game_config.json; layouts come
## from the world data. There is no per-genre code here.
##
## Art and audio are optional: when Weaverbird's asset stage has
## run, sprites and sounds load from res://assets/; otherwise
## the game draws shapes in code and stays silent.

const ARENA := Rect2(24, 24, 1104, 600)
const WORLD_HEIGHT: float = 648.0
const PLATFORM_HEIGHT: float = 22.0
const BACKGROUND_COLOR := Color(0.07, 0.08, 0.11)
const FLOOR_COLOR := Color(0.13, 0.15, 0.20)
const HAZARD_COLOR := Color(0.88, 0.30, 0.30)
const CELL: float = 62.0

const TARGET_SPOTS: Array = [
    Vector2(120, 110), Vector2(340, 110), Vector2(576, 115), Vector2(810, 110),
    Vector2(1030, 110), Vector2(200, 300), Vector2(120, 540), Vector2(340, 545),
    Vector2(576, 540), Vector2(810, 545), Vector2(1030, 540), Vector2(950, 300),
]

var cfg: Dictionary = {}
var plan: Dictionary = {}
var movement: String = "top_down_2d"
var objective: String = "collect"
var fail_rules: Array = []
var collectible_label: String = "Targets"
var hazard_label: String = "Hazards"
var goal_label: String = "Goal"

var accent := Color(0.42, 0.30, 0.95)
var target_color := Color(0.25, 0.80, 0.45)
var platform_color := Color(0.23, 0.26, 0.35)
var crate_color := Color(0.62, 0.42, 0.22)
var player_speed: float = 330.0
var hazard_speed: float = 1.4
var round_seconds: float = 60.0
var lives_start: int = 1

var _world_units: Array = []
var _unit_index: int = 0
var _deaths: int = 0
var _lives: int = 1
var _units_done: int = 0
var _finished: bool = false
var _is_paused: bool = false
var _hud: Label
var _hint: Label
var _pause_layer: CanvasLayer
var _sfx: Dictionary = {}
var _music: AudioStreamPlayer

# --- top_down_2d state ---
var _player: Player
var _targets: Array = []
var _hazard_nodes: Array = []
var _goal_node: Marker
var _collected: int = 0
var _total_collected: int = 0
var _time_left: float = 60.0
var _between: float = 0.0
var _grace: float = 0.0
var _spawn := Vector2(576, 470)

# --- side_view state ---
var _camera: Camera2D
var _world_node: Node2D
var _platforms: Array = []
var _spike_zones: Array = []
var _exit_pos := Vector2.ZERO
var _level_spawn := Vector2(80, 480)
var _level_width: float = 1500.0
var _level_stars: int = 0
var _level_star_total: int = 0
var _stars_banked: int = 0
var stars_collected: int = 0
var _timer_left: float = 0.0
var _respawn_guard: float = 0.0
var _level_change_pending: bool = false

# --- grid_step state ---
var puzzles: Array = []
var moves_used: int = 0
var move_budget: int = 120
var deadlock_detected: bool = false
var _walls: Array = []
var _pads: Array = []
var _crates: Array = []
var _player_cell := Vector2i.ZERO
var _cols: int = 0
var _rows: int = 0
var _origin := Vector2.ZERO
var _history: Array = []
var _advance_timer: float = 0.0
var _sprites: Dictionary = {}

const GRID_DIRS := {
    "move_left": Vector2i(-1, 0), "move_right": Vector2i(1, 0),
    "move_up": Vector2i(0, -1), "move_down": Vector2i(0, 1),
}


func _ready() -> void:
    _maybe_add_model_bridge()
    InputSetup.ensure_actions()
    _load_config()
    SettingsStore.apply_volume(SettingsStore.get_volume())
    _setup_audio()
    _build_hud()
    _build_pause_overlay()
    var pause_input: Node = preload("res://scripts/pause_input.gd").new()
    pause_input.process_mode = Node.PROCESS_MODE_ALWAYS
    pause_input.set("on_pause", Callable(self, "_toggle_pause"))
    add_child(pause_input)
    match movement:
        "side_view":
            _player = Player.new()
            _player.name = "Player"
            _player.mode = "side"
            _player.colour = accent
            _player.speed = player_speed
            _player.jump_strength = clampf(
                float(cfg.get("jump_strength", 545.0)), 300.0, 800.0)
            _player.gravity = clampf(
                float(cfg.get("gravity", 1400.0)), 700.0, 2400.0)
            add_child(_player)
            _camera = Camera2D.new()
            _camera.position = Vector2(576, 324)
            add_child(_camera)
            _camera.make_current()
            _build_level(0)
        "grid_step":
            _load_sprites()
            _load_puzzle(0)
        _:
            _player = Player.new()
            _player.name = "Player"
            _player.mode = "top"
            _player.bounds = ARENA
            _player.colour = accent
            _player.speed = player_speed
            add_child(_player)
            _start_round(0)
    _update_hud()


func _load_config() -> void:
    var path := "res://game_config.json"
    if FileAccess.file_exists(path):
        var parsed: Variant = JSON.parse_string(
            FileAccess.get_file_as_string(path))
        if typeof(parsed) == TYPE_DICTIONARY:
            cfg = parsed
    accent = Color.html(str(cfg.get("accent_hex", "#6C4CF1")))
    target_color = Color.html(str(cfg.get("target_hex", "#40CC73")))
    platform_color = Color.html(str(cfg.get("platform_hex", "#3B4259")))
    crate_color = Color.html(str(cfg.get("crate_hex", "#9E6B38")))
    plan = cfg.get("plan", {}) if typeof(cfg.get("plan", {})) == TYPE_DICTIONARY else {}
    movement = str(plan.get("movement", movement))
    objective = str(plan.get("objective", objective))
    fail_rules = plan.get("fail", [])
    collectible_label = str(cfg.get("collectible_label", "Targets"))
    for entity in plan.get("entities", []):
        if typeof(entity) != TYPE_DICTIONARY:
            continue
        match str(entity.get("kind", "")):
            "hazard":
                hazard_label = str(entity.get("label", hazard_label))
            "goal":
                goal_label = str(entity.get("label", goal_label))
    player_speed = clampf(float(cfg.get("player_speed", 330.0)), 100.0, 600.0)
    hazard_speed = clampf(float(cfg.get("hazard_speed", 1.4)), 0.3, 3.5)
    round_seconds = clampf(float(cfg.get("round_seconds", 60.0)), 15.0, 300.0)
    lives_start = clampi(int(cfg.get("lives", 1)), 1, 9)
    _lives = lives_start
    # The world worker's data wins: units live in
    # world/world.json, written as data — never baked into code.
    var world_path := "res://world/world.json"
    if FileAccess.file_exists(world_path):
        var wparsed: Variant = JSON.parse_string(
            FileAccess.get_file_as_string(world_path))
        if typeof(wparsed) == TYPE_DICTIONARY:
            _world_units = wparsed.get("units", [])
    if movement == "grid_step":
        puzzles = _world_units
        if puzzles.is_empty():
            puzzles = [_fallback_puzzle()]


func _entity_behaviour(kind: String) -> String:
    for entity in plan.get("entities", []):
        if typeof(entity) == TYPE_DICTIONARY \
                and str(entity.get("kind", "")) == kind:
            return str(entity.get("behaviour", "static"))
    return "static"


func _has_entity(kind: String) -> bool:
    for entity in plan.get("entities", []):
        if typeof(entity) == TYPE_DICTIONARY \
                and str(entity.get("kind", "")) == kind:
            return true
    return false


func _setup_audio() -> void:
    for sfx_name in ["click", "collect", "hurt", "jump", "push",
                     "win", "lose"]:
        var player := WbAssets.make_sfx_player(self, sfx_name + ".wav")
        if player != null:
            _sfx[sfx_name] = player
    _music = WbAssets.start_music(self)


func _play_sfx(sfx_name: String) -> void:
    var player: AudioStreamPlayer = _sfx.get(sfx_name)
    if player != null:
        player.play()


# ---------------------------------------------------------------------------
# Shared shell pieces

func _build_hud() -> void:
    var layer := CanvasLayer.new()
    add_child(layer)
    _hud = Label.new()
    _hud.position = Vector2(36, 30)
    _hud.add_theme_font_size_override("font_size", 18)
    _hud.add_theme_color_override("font_color", Color(0.92, 0.93, 0.96))
    layer.add_child(_hud)
    _hint = Label.new()
    _hint.position = Vector2(36, 596)
    _hint.add_theme_font_size_override("font_size", 15)
    _hint.add_theme_color_override("font_color", Color(0.62, 0.66, 0.74))
    _hint.text = str(cfg.get("objective_hint",
        "Follow the on-screen objective."))
    layer.add_child(_hint)


func _build_pause_overlay() -> void:
    _pause_layer = CanvasLayer.new()
    _pause_layer.layer = 5
    _pause_layer.process_mode = Node.PROCESS_MODE_ALWAYS
    _pause_layer.visible = false
    add_child(_pause_layer)
    var dim := ColorRect.new()
    dim.color = Color(0, 0, 0, 0.55)
    dim.set_anchors_preset(Control.PRESET_FULL_RECT)
    _pause_layer.add_child(dim)
    var column := UiTheme.centered_column(_pause_layer)
    column.add_child(UiTheme.make_label("Paused", 32))
    var resume := UiTheme.make_button("Resume")
    resume.pressed.connect(_toggle_pause)
    column.add_child(resume)
    var restart := UiTheme.make_button("Restart")
    restart.pressed.connect(_on_restart_pressed)
    column.add_child(restart)
    var menu := UiTheme.make_button("Main menu")
    menu.pressed.connect(_on_menu_pressed)
    column.add_child(menu)


func _toggle_pause() -> void:
    if _finished:
        return
    _is_paused = not _is_paused
    get_tree().paused = _is_paused
    _pause_layer.visible = _is_paused


func _on_restart_pressed() -> void:
    get_tree().paused = false
    get_tree().reload_current_scene()


func _on_menu_pressed() -> void:
    get_tree().paused = false
    get_tree().change_scene_to_file("res://scenes/main_menu.tscn")


func _score_totals() -> Array:
    # [collected, total] for the shell's win / game-over screens.
    match movement:
        "side_view":
            return [stars_collected, _stars_total()]
        "grid_step":
            return [_units_done, puzzles.size()]
        _:
            if objective == "collect":
                var total := 0
                for unit in _world_units:
                    total += (unit.get("collectibles", []) as Array).size()
                return [_total_collected, maxi(total, 1)]
            return [_units_done, maxi(_world_units.size(), 1)]


func _win(message: String) -> void:
    if _finished:
        return
    _finished = true
    _play_sfx("win")
    var totals := _score_totals()
    SettingsStore.record_run(true, int(totals[0]))
    RunInfo.result = "win"
    RunInfo.deaths = _deaths
    RunInfo.targets_collected = int(totals[0])
    RunInfo.targets_total = int(totals[1])
    RunInfo.targets_label = collectible_label if objective == "collect" \
        else ""
    RunInfo.message = message
    get_tree().call_deferred("change_scene_to_file", "res://scenes/win.tscn")


func _lose(reason: String) -> void:
    if _finished:
        return
    _finished = true
    _play_sfx("lose")
    var totals := _score_totals()
    SettingsStore.record_run(false, int(totals[0]))
    RunInfo.result = "lose"
    RunInfo.deaths = _deaths
    RunInfo.targets_collected = int(totals[0])
    RunInfo.targets_total = int(totals[1])
    RunInfo.targets_label = collectible_label if objective == "collect" \
        else ""
    RunInfo.message = reason
    get_tree().call_deferred(
        "change_scene_to_file", "res://scenes/game_over.tscn")


func _process(delta: float) -> void:
    if _finished or _is_paused:
        return
    match movement:
        "side_view":
            _process_side(delta)
        "grid_step":
            _process_grid(delta)
        _:
            _process_top(delta)


func _update_hud() -> void:
    if _hud == null:
        return
    match movement:
        "side_view":
            var timer_text := ""
            if fail_rules.has("timer"):
                timer_text = "    Time: %d" % int(ceil(maxf(_timer_left, 0.0)))
            _hud.text = "Level: %d / %d    %s: %d    Lives: %d%s" % [
                _unit_index + 1, maxi(_world_units.size(), 1),
                collectible_label, stars_collected, maxi(_lives, 0),
                timer_text]
        "grid_step":
            _hud.text = "Puzzle: %d / %d    Moves: %d / %d" % [
                _unit_index + 1, maxi(puzzles.size(), 1),
                moves_used, move_budget]
            if deadlock_detected:
                _hint.text = "A crate is stuck in a corner — press E to undo, or restart from the pause menu."
            else:
                _hint.text = str(cfg.get("objective_hint",
                    "Push every crate onto a glowing pad. E undoes a step."))
        _:
            var parts: Array = []
            parts.append("Round: %d / %d" % [
                _unit_index + 1, maxi(_world_units.size(), 1)])
            if objective == "collect":
                parts.append("%s: %d / %d" % [
                    collectible_label, _collected, _round_goal_count()])
            elif objective == "reach":
                parts.append("%s: %d / %d" % [
                    collectible_label, _total_collected,
                    _collectibles_total()])
            if objective == "survive" or fail_rules.has("timer"):
                parts.append("Time: %d" % int(ceil(maxf(_time_left, 0.0))))
            if fail_rules.has("hazard_contacts") and lives_start > 1:
                parts.append("Lives: %d" % maxi(_lives, 0))
            _hud.text = "    ".join(parts)


func _draw() -> void:
    match movement:
        "side_view":
            _draw_side()
        "grid_step":
            _draw_grid()
        _:
            draw_rect(Rect2(0, 0, 1152, 648), BACKGROUND_COLOR)
            draw_rect(ARENA, FLOOR_COLOR)
            draw_rect(ARENA, Color(1, 1, 1, 0.25), false, 2.0)


# ---------------------------------------------------------------------------
# top_down_2d

func _round_goal_count() -> int:
    return _targets.size()


func _collectibles_total() -> int:
    var total := 0
    for unit in _world_units:
        total += (unit.get("collectibles", []) as Array).size()
    return total


func _unit_collectible_spots(index: int) -> Array:
    if index >= 0 and index < _world_units.size():
        var placed: Array = _world_units[index].get("collectibles", [])
        if not placed.is_empty():
            var out: Array = []
            for spot in placed:
                out.append(Vector2(float(spot[0]), float(spot[1])))
            return out
    if objective != "collect" and objective != "reach":
        return []
    var count := mini(int(cfg.get("targets_per_round", 5)), TARGET_SPOTS.size())
    var fallback: Array = []
    for i in count:
        fallback.append(TARGET_SPOTS[(i + index) % TARGET_SPOTS.size()])
    return fallback


func _unit_hazard_defs(index: int) -> Array:
    # [{pos, range, behaviour}] — from the world data when it
    # carries hazard definitions, else the built-in table.
    if index >= 0 and index < _world_units.size():
        var defs: Array = _world_units[index].get("hazards", [])
        if not defs.is_empty():
            return defs
    if not _has_entity("hazard"):
        return []
    var spots: Array = [
        {"pos": [400, 330], "range": 170.0, "behaviour": "patrol"},
        {"pos": [740, 452], "range": 140.0, "behaviour": "patrol"},
        {"pos": [300, 200], "range": 130.0, "behaviour": "patrol"},
        {"pos": [850, 240], "range": 120.0, "behaviour": "patrol"},
        {"pos": [576, 380], "range": 180.0, "behaviour": "patrol"},
    ]
    return spots.slice(0, mini(2 + index, 5))


func _start_round(index: int) -> void:
    _unit_index = index
    for node in _targets + _hazard_nodes:
        (node as Node).queue_free()
    _targets.clear()
    _hazard_nodes.clear()
    if _goal_node != null:
        _goal_node.queue_free()
        _goal_node = null
    _collected = 0
    _between = 0.0
    _grace = 0.0
    var unit: Dictionary = {}
    if index < _world_units.size():
        unit = _world_units[index]
    # The config's round_seconds is the tunable surface (balance
    # patches change it without rebuilding the world); the
    # unit's copy is the build-time record.
    _time_left = clampf(round_seconds,
                        15.0, 300.0)
    var spawn_arr: Array = unit.get("spawn", [576, 470])
    _spawn = Vector2(float(spawn_arr[0]), float(spawn_arr[1]))
    _player.position = _spawn
    var collect_behaviour := _entity_behaviour("collectible")
    for spot in _unit_collectible_spots(index):
        var marker := Marker.new()
        marker.kind = "target"
        marker.behaviour = collect_behaviour
        marker.colour = target_color
        marker.bounds = ARENA
        marker.move_speed = 190.0 if collect_behaviour == "flee" else 45.0
        marker.position = spot
        add_child(marker)
        marker.target_node = _player
        marker.add_to_group("targets")
        _targets.append(marker)
    var hazard_behaviour := _entity_behaviour("hazard")
    for definition in _unit_hazard_defs(index):
        var d: Dictionary = definition
        var pos: Array = d.get("pos", [0, 0])
        var hazard := Marker.new()
        hazard.kind = "hazard"
        hazard.behaviour = str(d.get("behaviour", hazard_behaviour))
        hazard.colour = HAZARD_COLOR
        hazard.radius = 14.0
        hazard.bounds = ARENA
        hazard.position = Vector2(float(pos[0]), float(pos[1]))
        hazard.patrol_range = float(d.get("range", 0.0))
        hazard.patrol_speed = hazard_speed * (1.0 + 0.12 * index)
        hazard.move_speed = hazard_speed * (95.0 if hazard.behaviour == "chase" else 70.0)
        add_child(hazard)
        hazard.target_node = _player
        hazard.add_to_group("hazards")
        _hazard_nodes.append(hazard)
    if unit.has("goal"):
        var g: Array = unit["goal"]
        var goal := Marker.new()
        goal.kind = "goal"
        goal.colour = accent
        goal.radius = 16.0
        goal.position = Vector2(float(g[0]), float(g[1]))
        add_child(goal)
        goal.add_to_group("goal")
        _goal_node = goal
        _refresh_goal_lock()
    if _has_entity("ambient"):
        var rng := RandomNumberGenerator.new()
        rng.seed = int(cfg.get("world_seed", 0)) * 31 + index
        for i in 4:
            var ambient := Marker.new()
            ambient.kind = "ambient"
            ambient.behaviour = "wander"
            ambient.colour = target_color
            ambient.bounds = ARENA
            ambient.move_speed = 40.0
            ambient.position = Vector2(
                rng.randf_range(90.0, 1060.0), rng.randf_range(90.0, 560.0))
            add_child(ambient)
            _hazard_nodes.append(ambient)  # freed with the round; harmless
    _update_hud()


func _refresh_goal_lock() -> void:
    if _goal_node == null:
        return
    var locked := objective == "collect" and not _targets.is_empty()
    _goal_node.modulate = Color(1, 1, 1, 0.35) if locked else Color.WHITE


func _process_top(delta: float) -> void:
    if _between > 0.0:
        _between -= delta
        if _between <= 0.0:
            _start_round(_unit_index + 1)
        return
    if _grace > 0.0:
        _grace -= delta
    if objective == "survive":
        _time_left -= delta
        if _time_left <= 0.0:
            _time_left = 0.0
            _complete_unit_top()
            return
    elif fail_rules.has("timer"):
        _time_left -= delta
        if _time_left <= 0.0:
            _time_left = 0.0
            _lose("Time ran out.")
            return
    _check_top_markers()
    _update_hud()


func _check_top_markers() -> void:
    for target in _targets.duplicate():
        var reach: float = _player.radius + (target as Marker).radius
        if _player.global_position.distance_to(
                (target as Node2D).global_position) <= reach:
            _targets.erase(target)
            (target as Node).queue_free()
            _collected += 1
            _total_collected += 1
            _play_sfx("collect")
            _refresh_goal_lock()
            if objective == "collect" and _goal_node == null \
                    and _targets.is_empty():
                _complete_unit_top()
                return
    if _goal_node != null:
        var goal_reach: float = _player.radius + _goal_node.radius
        if _player.global_position.distance_to(
                _goal_node.global_position) <= goal_reach:
            if objective == "reach":
                _complete_unit_top()
                return
            if objective == "collect" and _targets.is_empty():
                _complete_unit_top()
                return
    if fail_rules.has("hazard_contacts") and _grace <= 0.0:
        for hazard in get_tree().get_nodes_in_group("hazards"):
            var node := hazard as Node2D
            var reach: float = _player.radius + 14.0 - 2.0
            if _player.global_position.distance_to(
                    node.global_position) <= reach:
                _hurt_top()
                return


func _hurt_top() -> void:
    _deaths += 1
    _lives -= 1
    _play_sfx("hurt")
    if _lives <= 0:
        _lose("The %s got you." % hazard_label.to_lower())
        return
    _player.position = _spawn
    _grace = 1.2


func _complete_unit_top() -> void:
    _units_done += 1
    if _unit_index + 1 >= maxi(_world_units.size(), 1):
        _win("Every round cleared.")
    else:
        _between = 1.0
        _update_hud()


# ---------------------------------------------------------------------------
# side_view

func _fallback_level() -> Dictionary:
    return {
        "platforms": [[0, 560, 1500], [240, 470, 130], [470, 400, 130],
                      [700, 470, 130], [950, 400, 130]],
        "collectibles": [[305, 440], [535, 370], [765, 440], [1015, 370]],
        "spikes": [],
        "spawn": [80, 500],
        "exit": [1400, 516],
        "width": 1500,
    }


func _build_level(index: int) -> void:
    _unit_index = index
    if _world_node != null:
        _world_node.queue_free()
    _world_node = Node2D.new()
    _world_node.name = "World"
    add_child(_world_node)
    move_child(_world_node, 0)
    var level: Dictionary = _world_units[index] \
        if index < _world_units.size() else _fallback_level()
    _level_width = float(level.get("width", 1500))
    _platforms = level.get("platforms", [])
    _spike_zones = level.get("spikes", [])
    var spawn_arr: Array = level.get("spawn", [80, 500])
    _level_spawn = Vector2(float(spawn_arr[0]), float(spawn_arr[1]))
    var exit_arr: Array = level.get("exit", [1400, 516])
    _exit_pos = Vector2(float(exit_arr[0]), float(exit_arr[1]))
    for platform in _platforms:
        var p: Array = platform
        var body := StaticBody2D.new()
        body.position = Vector2(float(p[0]) + float(p[2]) / 2.0,
                                float(p[1]) + PLATFORM_HEIGHT / 2.0)
        var shape := CollisionShape2D.new()
        var rect := RectangleShape2D.new()
        rect.size = Vector2(float(p[2]), PLATFORM_HEIGHT)
        shape.shape = rect
        body.add_child(shape)
        _world_node.add_child(body)
        var tile := WbAssets.texture_or_null("platform_tile.svg")
        if tile != null:
            var rect_control := TextureRect.new()
            rect_control.texture = tile
            rect_control.stretch_mode = TextureRect.STRETCH_TILE
            rect_control.position = Vector2(float(p[0]), float(p[1]))
            rect_control.size = Vector2(float(p[2]), PLATFORM_HEIGHT)
            _world_node.add_child(rect_control)
    _level_stars = 0
    var collectibles: Array = level.get("collectibles", [])
    _level_star_total = collectibles.size()
    for spot in collectibles:
        var s: Array = spot
        var star := Star.new()
        star.colour = target_color
        star.position = Vector2(float(s[0]), float(s[1]))
        _world_node.add_child(star)
        star.body_entered.connect(_on_star_body_entered.bind(star))
    for zone in _spike_zones:
        var z: Array = zone
        var area := Area2D.new()
        area.position = Vector2(float(z[0]) + float(z[2]) / 2.0, float(z[1]))
        var shape := CollisionShape2D.new()
        var rect := RectangleShape2D.new()
        rect.size = Vector2(float(z[2]), 20.0)
        shape.shape = rect
        area.add_child(shape)
        area.add_to_group("spikes")
        area.add_to_group("hazards")
        _world_node.add_child(area)
        area.body_entered.connect(_on_spike_body_entered)
        var spikes_tex := WbAssets.texture_or_null("spikes.svg")
        if spikes_tex != null:
            var sprite := Sprite2D.new()
            sprite.texture = spikes_tex
            var base := spikes_tex.get_size()
            sprite.scale = Vector2(float(z[2]) / maxf(base.x, 1.0),
                                   20.0 / maxf(base.y, 1.0))
            sprite.position = area.position + Vector2(0, 2)
            _world_node.add_child(sprite)
    var exit_area := Area2D.new()
    exit_area.position = _exit_pos
    var exit_shape := CollisionShape2D.new()
    var exit_rect := RectangleShape2D.new()
    exit_rect.size = Vector2(36, 48)
    exit_shape.shape = exit_rect
    exit_area.add_child(exit_shape)
    exit_area.add_to_group("exit_door")
    exit_area.add_to_group("goal")
    _world_node.add_child(exit_area)
    exit_area.body_entered.connect(_on_exit_body_entered)
    var door := WbAssets.add_sprite(exit_area, "exit_door.svg", 52.0)
    if door == null:
        var door_draw := Node2D.new()
        door_draw.set_script(preload("res://scripts/door_draw.gd"))
        door_draw.set("colour", accent)
        exit_area.add_child(door_draw)
    _player.position = _level_spawn
    _player.velocity = Vector2.ZERO
    _respawn_guard = 0.8
    _timer_left = float(cfg.get("timer_seconds", 0.0)) \
        if fail_rules.has("timer") else 0.0
    queue_redraw()
    _update_hud()


func _stars_total() -> int:
    var total := 0
    for level in _world_units:
        total += (level.get("collectibles", []) as Array).size()
    return total


func _on_star_body_entered(body: Node2D, star: Star) -> void:
    if body != _player or _finished or star.is_queued_for_deletion():
        return
    star.set_deferred("monitoring", false)
    star.call_deferred("queue_free")
    _level_stars += 1
    stars_collected = _stars_banked + _level_stars
    _play_sfx("collect")
    _update_hud()


func _on_spike_body_entered(body: Node2D) -> void:
    if body == _player:
        _hurt_side("The spikes got you.")


func _on_exit_body_entered(body: Node2D) -> void:
    if body != _player or _finished or _level_change_pending:
        return
    if objective == "collect" and _level_stars < _level_star_total:
        return  # the door opens once the level is gathered clean
    _stars_banked = stars_collected
    _play_sfx("click")
    _level_change_pending = true
    call_deferred("_advance_level")


func _advance_level() -> void:
    _level_change_pending = false
    if _finished:
        return
    _units_done += 1
    if _unit_index + 1 >= maxi(_world_units.size(), 1):
        _win("Every level finished.")
    else:
        _build_level(_unit_index + 1)


func _hurt_side(reason: String) -> void:
    if _finished or _respawn_guard > 0.0 or _level_change_pending:
        return
    _lives -= 1
    _deaths += 1
    _play_sfx("hurt")
    if _lives <= 0:
        _lose(reason)
        return
    stars_collected = _stars_banked
    _level_change_pending = true
    _respawn_guard = 1.2
    call_deferred("_rebuild_level")


func _rebuild_level() -> void:
    _level_change_pending = false
    if not _finished:
        _build_level(_unit_index)


func _process_side(delta: float) -> void:
    if _respawn_guard > 0.0:
        _respawn_guard -= delta
    if fail_rules.has("timer") and _timer_left > 0.0:
        _timer_left -= delta
        if _timer_left <= 0.0:
            _hurt_side("Time ran out.")
    if _player.position.y > WORLD_HEIGHT + 60.0:
        _hurt_side("You fell out of the world.")
    if _camera != null:
        var half_view := 576.0
        var target_x := clampf(_player.position.x, half_view,
                               maxf(_level_width - half_view, half_view))
        _camera.position = Vector2(target_x, 324)
    _update_hud()


func _draw_side() -> void:
    draw_rect(Rect2(0, 0, 2400, WORLD_HEIGHT), BACKGROUND_COLOR)
    if _world_node == null:
        return
    for platform in _platforms:
        var p: Array = platform
        var rect := Rect2(float(p[0]), float(p[1]), float(p[2]),
                          PLATFORM_HEIGHT)
        draw_rect(rect, platform_color)
        draw_rect(Rect2(rect.position, Vector2(rect.size.x, 4)), accent)
    for zone in _spike_zones:
        var z: Array = zone
        var count := int(float(z[2]) / 16.0)
        for i in maxi(count, 1):
            var x0 := float(z[0]) + i * 16.0
            var base_y := float(z[1]) + 10.0
            draw_colored_polygon(PackedVector2Array([
                Vector2(x0, base_y), Vector2(x0 + 8, base_y - 18),
                Vector2(x0 + 16, base_y)]), HAZARD_COLOR)


# ---------------------------------------------------------------------------
# grid_step (deliver)

func _fallback_puzzle() -> Dictionary:
    return {
        "grid": [
            "########",
            "#      #",
            "# . $ @#",
            "#      #",
            "########",
        ],
        "budget": 120,
        "solution": "ll",
    }


func _load_sprites() -> void:
    for key in ["player", "crate", "pad", "wall"]:
        var tex := WbAssets.texture_or_null(key + ".svg")
        if tex != null:
            _sprites[key] = tex


func _load_puzzle(index: int) -> void:
    _unit_index = index
    var puzzle: Dictionary = puzzles[index]
    var grid: Array = puzzle.get("grid", [])
    _rows = grid.size()
    _cols = 0
    _walls.clear()
    _pads.clear()
    _crates.clear()
    _history.clear()
    moves_used = 0
    deadlock_detected = false
    # The budget is tuning: derived live from the puzzle's
    # verified solution and the config's multiplier, so a patch
    # that retunes the multiplier takes effect without the world
    # being rebuilt.
    var solution := str(puzzle.get("solution", ""))
    if cfg.has("move_budget_multiplier") and not solution.is_empty():
        # Exact by design: undo refunds its move, so no slack is
        # needed, and the repair/patch loops reason about this
        # multiplier directly — budget == solution x multiplier.
        move_budget = maxi(1, int(len(solution)
            * float(cfg.get("move_budget_multiplier", 2.5))))
    else:
        move_budget = int(puzzle.get("budget", 120))
    for y in _rows:
        var row := str(grid[y])
        _cols = maxi(_cols, row.length())
        for x in row.length():
            var cell := Vector2i(x, y)
            match row[x]:
                "#":
                    _walls.append(cell)
                ".":
                    _pads.append(cell)
                "$":
                    _crates.append(cell)
                "*":
                    _crates.append(cell)
                    _pads.append(cell)
                "@":
                    _player_cell = cell
                "+":
                    _player_cell = cell
                    _pads.append(cell)
    _origin = Vector2((1152.0 - _cols * CELL) / 2.0,
                      (648.0 - _rows * CELL) / 2.0 + 12.0)
    queue_redraw()
    _update_hud()


func _cell_center(cell: Vector2i) -> Vector2:
    return _origin + Vector2(cell) * CELL + Vector2(CELL, CELL) / 2.0


func _process_grid(delta: float) -> void:
    if _advance_timer > 0.0:
        _advance_timer -= delta
        if _advance_timer <= 0.0:
            _units_done += 1
            if _unit_index + 1 >= puzzles.size():
                _win("Every puzzle solved.")
            else:
                _load_puzzle(_unit_index + 1)
        return
    for action in GRID_DIRS.keys():
        if Input.is_action_just_pressed(action):
            _try_move(GRID_DIRS[action])
            return
    if Input.is_action_just_pressed("interact"):
        _undo_move()


func _try_move(step: Vector2i) -> void:
    var next := _player_cell + step
    if _walls.has(next):
        return
    var pushed := false
    if _crates.has(next):
        var beyond := next + step
        if _walls.has(beyond) or _crates.has(beyond):
            return
        pushed = true
    _history.append([_player_cell, _crates.duplicate(), moves_used])
    if pushed:
        _crates.erase(next)
        _crates.append(next + step)
        _play_sfx("push")
    _player_cell = next
    moves_used += 1
    deadlock_detected = _check_deadlock()
    queue_redraw()
    _update_hud()
    if _all_on_pads():
        _play_sfx("collect")
        _advance_timer = 1.0
    elif moves_used >= move_budget:
        _lose("Out of moves — the budget for this puzzle is spent.")


func _undo_move() -> void:
    if _history.is_empty():
        return
    var previous: Array = _history.pop_back()
    _player_cell = previous[0]
    _crates = (previous[1] as Array).duplicate()
    moves_used = int(previous[2])
    deadlock_detected = _check_deadlock()
    queue_redraw()
    _update_hud()


func _all_on_pads() -> bool:
    for crate in _crates:
        if not _pads.has(crate):
            return false
    return not _crates.is_empty()


func _check_deadlock() -> bool:
    for crate in _crates:
        if _pads.has(crate):
            continue
        var c: Vector2i = crate
        var up := _walls.has(c + Vector2i(0, -1))
        var down := _walls.has(c + Vector2i(0, 1))
        var left := _walls.has(c + Vector2i(-1, 0))
        var right := _walls.has(c + Vector2i(1, 0))
        if (up or down) and (left or right):
            return true
    return false


func _draw_grid() -> void:
    draw_rect(Rect2(0, 0, 1152, 648), BACKGROUND_COLOR)
    var floor_rect := Rect2(_origin, Vector2(_cols * CELL, _rows * CELL))
    draw_rect(floor_rect, FLOOR_COLOR)
    for y in _rows:
        for x in _cols:
            var cell := Vector2i(x, y)
            var rect := Rect2(_origin + Vector2(cell) * CELL,
                              Vector2(CELL, CELL))
            if _walls.has(cell):
                if not _draw_texture_at("wall", cell, 1.0):
                    draw_rect(rect, platform_color)
                    draw_rect(rect, Color(1, 1, 1, 0.18), false, 2.0)
            else:
                draw_rect(rect, Color(1, 1, 1, 0.05), false, 1.0)
    for pad in _pads:
        if not _draw_texture_at("pad", pad, 8.0):
            var rect := Rect2(_cell_center(pad) - Vector2(17, 17),
                              Vector2(34, 34))
            draw_rect(rect, target_color, false, 3.0)
    for crate in _crates:
        var on_pad := _pads.has(crate)
        if not _draw_texture_at("crate", crate, 5.0):
            var rect := Rect2(_origin + Vector2(crate) * CELL + Vector2(5, 5),
                              Vector2(CELL - 10, CELL - 10))
            draw_rect(rect, crate_color)
            draw_rect(rect, Color(1, 1, 1, 0.55), false, 2.0)
            draw_line(rect.position + Vector2(4, 4),
                      rect.position + rect.size - Vector2(4, 4),
                      Color(0, 0, 0, 0.25), 2.0)
        if on_pad:
            var ring := Rect2(_origin + Vector2(crate) * CELL + Vector2(2, 2),
                              Vector2(CELL - 4, CELL - 4))
            draw_rect(ring, target_color, false, 3.0)
    if not _draw_texture_at("player", _player_cell, 9.0):
        draw_circle(_cell_center(_player_cell), CELL * 0.32, accent)
        draw_circle(_cell_center(_player_cell), CELL * 0.14,
                    Color(1, 1, 1, 0.85))


func _draw_texture_at(key: String, cell: Vector2i, inset: float) -> bool:
    if not _sprites.has(key):
        return false
    var tex: Texture2D = _sprites[key]
    var rect := Rect2(_origin + Vector2(cell) * CELL + Vector2(inset, inset),
                      Vector2(CELL - inset * 2.0, CELL - inset * 2.0))
    draw_texture_rect(tex, rect, false)
    return true


